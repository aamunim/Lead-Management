  "message_templates": [
    {
      "key": "follow_up",
      "purpose": "follow_up",
      "text": {
        "en": "Dear {name}, thank you for your interest in {institution}. Call us at {phone} for any question.",
        "bn": "প্রিয় {name}, {institution}-এ আগ্রহের জন্য ধন্যবাদ। যেকোনো প্রশ্নে {phone} নম্বরে কল করুন।"
      }
    },
    {
      "key": "visit_reminder",
      "purpose": "appointment",
      "text": {
        "en": "Reminder: your visit to {institution} is on {date} at {time}.",
        "bn": "মনে করিয়ে দিচ্ছি: {date} তারিখ {time}-এ {institution}-এ আপনার ভিজিট।"
      }
    },
    {
      "key": "test_date",
      "purpose": "assessment",
      "text": {
        "en": "The admission test for {offering} is on {date} at {time}. Please bring the admit card.",
        "bn": "{offering}-এর ভর্তি পরীক্ষা {date} তারিখ {time}-এ। প্রবেশপত্র সাথে আনুন।"
      }
    },
    {
      "key": "result",
      "purpose": "result",
      "text": {
        "en": "The result for {offering} is published. {name}: {result}.",
        "bn": "{offering}-এর ফলাফল প্রকাশিত হয়েছে। {name}: {result}।"
      }
    },
    {
      "key": "documents_due",
      "purpose": "documents",
      "text": {
        "en": "Please submit these documents for {name}: {documents}.",
        "bn": "{name}-এর এই কাগজগুলো জমা দিন: {documents}।"
      }
    },
    {
      "key": "welcome",
      "purpose": "welcome",
      "text": {
        "en": "Welcome to {institution}, {name}! Your number is {client_number}.",
        "bn": "{institution}-এ স্বাগতম, {name}! আপনার নম্বর {client_number}।"
      }
    }
  ],
