  "message_templates": [
    {
      "key": "follow_up",
      "purpose": "follow_up",
      "text": {
        "en": "Dear {name}, thank you for your interest in {institution}. Call us at {phone} for any question.",
        "bn": "প্রিয় {name}, {institution}-এ আগ্রহের জন্য ধন্যবাদ। যেকোনো প্রশ্নে {phone} নম্বরে কল করুন।"
      }
    },
    {
      "key": "demo_reminder",
      "purpose": "appointment",
      "text": {
        "en": "Your demo class for {offering} is on {date} at {time}.",
        "bn": "{offering}-এর ডেমো ক্লাস {date} তারিখ {time}-এ।"
      }
    },
    {
      "key": "batch_start",
      "purpose": "start",
      "text": {
        "en": "The new {cohort} of {offering} starts on {date}.",
        "bn": "{offering}-এর নতুন {cohort} শুরু {date} তারিখে।"
      }
    },
    {
      "key": "fee_due",
      "purpose": "fee_due",
      "text": {
        "en": "Dear guardian, the fee of {amount} for {name} is due on {date}.",
        "bn": "সম্মানিত অভিভাবক, {name}-এর {amount} টাকা ফি {date} তারিখের মধ্যে দিন।"
      }
    }
  ],
  "client_number_pattern": "{CODE}-{000}",
  "lead_score": {
    "points": {
      "called": 1,
      "answered": 2,
      "demo_attended": 15,
      "not_answered": -1
