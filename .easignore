# EAS build upload list (0A.20): same as .gitignore, except google-services.json, which build-android.yml writes
# from a secret just before the build. Keep in step with .gitignore. Never commit google-services.json.
# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# generated native folders (Continuous Native Generation)
/ios
/android

# Native signing material (never commit — Ch 3.8, lesson 12)
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
GoogleService-Info.plist

# Secrets and local env (never commit)
.env
.env.*
!.env.example

# Supabase local state
supabase/.branches/
supabase/.temp/

# Metro / debug / OS
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo
ui-screenshots/
bench-results/

# Large test and CI outputs the build does not need
tests/screenshots/
ui-screenshots/
bench-results/
