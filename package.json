{
  "name": "leadora",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:config": "node scripts/validate-config.mjs",
    "export:web": "expo export --platform web",
    "check": "npm run typecheck && npm run check:config && npm test",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"scripts/tests/*.test.mjs\"",
    "test:db": "bash scripts/db-test.sh",
    "test:e2e": "node --test \"scripts/e2e/*.e2e.mjs\"",
    "lint:schema": "bash scripts/schema-lint.sh",
    "db:extensions": "bash scripts/apply-extensions.sh",
    "test:lint": "bash scripts/tests/extension-lint.test.sh && psql \"${DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -X -q -v ON_ERROR_STOP=1 -f supabase/lint/tests/lint_fixtures_test.sql",
    "test:leak": "bash scripts/leak-test.sh",
    "test:leak-self": "psql \"${DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -X -q -v ON_ERROR_STOP=1 -f supabase/tests/leak/leak_selftest.sql",
    "check:functions": "npx --yes deno@2 check --config supabase/functions/deno.json supabase/functions/*/index.ts"
  },
  "private": true,
  "description": "Leadora: multi-institution lead and admission management platform."
}
