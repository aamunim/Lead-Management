# Copy to .env.local for local development (never commit .env files with real values).
# Local values: run `npx supabase status` and copy API_URL and PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=<publishable key from `supabase status`>
# Developer sign-in screen (/dev-sign-in). Never set in production builds.
EXPO_PUBLIC_DEV_SIGNIN=1
